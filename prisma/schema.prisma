generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Item {
  itemID                Int     @id @default(autoincrement())
  ownerID               String
  itemName              String
  itemQuantity          Int     @default(1)
  itemLink              String?
  itemImageURL          String?
  itemDescription       String?
  itemQuantityPurchased Int     @default(0)
  List                  List    @relation(fields: [ownerID], references: [ownerID])

  alternates     Item[] @relation("AlternateItems")
  alternateFor   Item?  @relation("AlternateItems", fields: [alternateForId], references: [itemID])
  alternateForId Int?
}

model List {
  ownerID    String  @id
  shareID    String? @unique
  auth0Owner String?
  listName   String  @default("List")
  Item       Item[]
}
